{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overwatch-hero-picker",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "beta": {
      "assets": {
        "directory": "out",
        "not_found_handling": "404-page",
      },
      "observability": {
        "enabled": true,
      },
      "routes": [
        {
          "pattern": "beta.owheropicker.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
