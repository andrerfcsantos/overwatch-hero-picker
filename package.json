{
  "name": "overwatch-hero-picker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "vp lint",
    "format": "vp fmt \"src/**/*.{ts,tsx,css}\"",
    "generate-sprites": "npx tsx scripts/generate-sprites.ts",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "deploy:beta": "next build && wrangler deploy --env beta",
    "upload": "next build && wrangler versions upload",
    "rooms:types": "wrangler types -c workers/rooms/wrangler.jsonc workers/rooms/worker-configuration.d.ts",
    "rooms:check": "npm run rooms:types && tsc -p workers/rooms",
    "rooms:dev": "wrangler dev -c workers/rooms/wrangler.jsonc --port 8787 --var ALLOWED_ORIGINS:http://localhost:3000,http://127.0.0.1:3000",
    "rooms:deploy": "wrangler deploy -c workers/rooms/wrangler.jsonc",
    "deps:check": "node scripts/deps.mts",
    "deps:update": "vp update && node scripts/deps.mts",
    "deps:update:major": "vp update --latest --interactive && node scripts/deps.mts"
  },
  "dependencies": {
    "next": "^16.2.6",
    "posthog-js": "^1.422.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.31.1",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite-plus": "latest",
    "wrangler": "^4.120.0"
  },
  "packageManager": "npm@11.12.0",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  }
}
