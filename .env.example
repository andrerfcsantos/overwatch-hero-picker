# PostHog browser analytics
#
# NEXT_PUBLIC_POSTHOG_HOST is the first-party reverse proxy
# (https://r.owheropicker.com, a CNAME to PostHog's managed proxy) rather than
# https://us.i.posthog.com, so ad blockers don't recognize the requests. The
# region-specific UI host is hardcoded in src/lib/analytics.ts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://r.owheropicker.com

# Stream overlay companion relay (workers/rooms). Defaults to
# wss://rooms.owheropicker.com; point it at `npm run rooms:dev` locally.
# NEXT_PUBLIC_ROOMS_URL=ws://127.0.0.1:8787

# Clerk authentication (client-only: the site is a static export, so only the
# publishable key is used). `npx clerk@latest env pull` writes the dev keys to
# .env.local; the production publishable key belongs in .env.production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
