# PostHog browser analytics
#
# NEXT_PUBLIC_POSTHOG_HOST is the first-party reverse proxy
# (https://r.owheropicker.com, a CNAME to PostHog's managed proxy) rather than
# https://us.i.posthog.com, so ad blockers don't recognize the requests. The
# region-specific UI host is hardcoded in src/lib/analytics.ts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://r.owheropicker.com
